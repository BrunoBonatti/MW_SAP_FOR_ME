<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:layout="sap.ui.layout"
    xmlns:u="sap.ui.unified"
    core:require="{formatter: 'megawork/mwmonitorchamados/model/formatter'}">
    <!-- So o modelo casoSap: sem bindElement em tickets, handler do detalhe C4C aqui quebraria. -->
    <f:DynamicPage
        id="detalheDynamicPageSap"
        busy="{casoSap>/carregando}"
        busyIndicatorDelay="0"
        headerExpanded="{view>/detalheHeaderExpandido}"
        preserveHeaderStateOnScroll="{view>/detalheEdicao}"
        toggleHeaderOnTitleClick="{= !${view>/detalheEdicao} }"
        class="sapUiResponsivePadding--title sapUiResponsivePadding--header sapUiResponsivePadding--content">
        <f:title>
            <f:DynamicPageTitle areaShrinkRatio="2.2:1:0.1">
                <!-- Breadcrumbs no heading, e nao em f:breadcrumbs, para caber o voltar ao lado. -->
                <f:heading>
                    <VBox>
                        <HBox
                            alignItems="Center"
                            class="sapUiTinyMarginBottom">
                            <Button
                                icon="sap-icon://nav-back"
                                type="Transparent"
                                tooltip="{i18n>detalheSapVoltar}"
                                press=".onDetalheVoltar"
                                class="mwDetalheVoltarBotao sapUiTinyMarginEnd"/>
                            <Breadcrumbs
                                currentLocationText="{casoSap>/caso/caseNumber}"
                                class="sapUiSmallMarginTop">
                                <Link
                                    text="{i18n>detalheSapBreadcrumbCasos}"
                                    tooltip="{i18n>detalheSapVoltar}"
                                    press=".onDetalheVoltar"/>
                            </Breadcrumbs>
                        </HBox>
                        <HBox
                            alignItems="Center"
                            wrap="Wrap"
                            class="sapUiTinyMarginBottom">
                            <Avatar
                                src="sap-icon://sap-logo-shape"
                                displayShape="Square"
                                displaySize="L"
                                backgroundColor="Accent6"
                                class="sapUiMediumMarginEnd sapUiTinyMarginBottom"/>
                            <VBox class="sapUiTinyMarginBottom">
                                <Title
                                    text="{casoSap>/caso/subject}"
                                    level="H2"
                                    wrapping="true"/>
                                <!-- state="None" nos tres: status/prioridade/produto da ALM sao texto
                                     livre, sem mapa de cor no formatter.js. -->
                                <HBox
                                    wrap="Wrap"
                                    alignItems="Center"
                                    class="sapUiTinyMarginTop">
                                    <ObjectStatus
                                        inverted="true"
                                        state="None"
                                        visible="{= !!${casoSap>/caso/status} }"
                                        text="{casoSap>/caso/status}"
                                        tooltip="{i18n>detalheSapStatus}"
                                        icon="sap-icon://process"
                                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
                                    <ObjectStatus
                                        inverted="true"
                                        state="None"
                                        visible="{= !!${casoSap>/caso/priority} }"
                                        text="{casoSap>/caso/priority}"
                                        tooltip="{i18n>detalheSapPrioridade}"
                                        icon="sap-icon://priority"
                                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
                                    <ObjectStatus
                                        inverted="true"
                                        state="None"
                                        visible="{= !!${casoSap>/caso/product} }"
                                        text="{casoSap>/caso/product}"
                                        tooltip="{i18n>detalheSapProduto}"
                                        icon="sap-icon://product"
                                        class="sapUiTinyMarginBottom"/>
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </f:heading>
                <f:actions>
                    <Button
                        id="detalheRefreshButtonSap"
                        icon="sap-icon://refresh"
                        type="Transparent"
                        tooltip="{i18n>detalheSapAtualizar}"
                        press=".onDetalheSapAtualizar"/>
                </f:actions>
                <f:expandedContent>
                    <HBox
                        width="100%"
                        justifyContent="SpaceBetween"
                        alignItems="Start"
                        wrap="Wrap"
                        class="sapUiMediumMarginTop">
                        <!-- Visible na faceta inteira: no valor sozinho sobraria rotulo orfao. -->
                        <VBox
                            width="12rem"
                            visible="{= !!${casoSap>/caso/createdAt} }"
                            class="sapUiTinyMarginBottom sapUiSmallMarginEnd">
                            <Label
                                text="{i18n>detalheSapAbertoEm}"
                                class="mwFacetaRotulo sapUiTinyMarginBottom"/>
                            <ObjectStatus
                                text="{path: 'casoSap>/caso/createdAt', formatter: 'formatter.dataAbertura'}"
                                icon="sap-icon://calendar"
                                state="None"
                                class="mwFacetaValor"/>
                        </VBox>
                        <VBox
                            width="12rem"
                            visible="{= !!${casoSap>/caso/updatedAt} }"
                            class="sapUiTinyMarginBottom sapUiSmallMarginEnd">
                            <Label
                                text="{i18n>detalheSapAtualizadoEm}"
                                class="mwFacetaRotulo sapUiTinyMarginBottom"/>
                            <ObjectStatus
                                text="{path: 'casoSap>/caso/updatedAt', formatter: 'formatter.dataAbertura'}"
                                icon="sap-icon://calendar"
                                state="None"
                                class="mwFacetaValor"/>
                        </VBox>
                        <VBox
                            width="12rem"
                            visible="{= !!${casoSap>/caso/closedAt} }"
                            class="sapUiTinyMarginBottom sapUiSmallMarginEnd">
                            <Label
                                text="{i18n>detalheSapEncerradoEm}"
                                class="mwFacetaRotulo sapUiTinyMarginBottom"/>
                            <ObjectStatus
                                text="{path: 'casoSap>/caso/closedAt', formatter: 'formatter.dataAbertura'}"
                                icon="sap-icon://locked"
                                state="None"
                                class="mwFacetaValor"/>
                        </VBox>
                        <VBox
                            width="12rem"
                            visible="{= !!${casoSap>/caso/customer} }"
                            class="sapUiTinyMarginBottom sapUiSmallMarginEnd">
                            <Label
                                text="{i18n>detalheSapCliente}"
                                class="mwFacetaRotulo sapUiTinyMarginBottom"/>
                            <ObjectStatus
                                text="{casoSap>/caso/customer}"
                                icon="sap-icon://building"
                                state="None"
                                class="mwFacetaValor"/>
                        </VBox>
                        <VBox
                            width="12rem"
                            visible="{= !!${casoSap>/caso/systemName} }"
                            class="sapUiTinyMarginBottom sapUiSmallMarginEnd">
                            <Label
                                text="{i18n>detalheSapSistema}"
                                class="mwFacetaRotulo sapUiTinyMarginBottom"/>
                            <ObjectStatus
                                text="{casoSap>/caso/systemName}"
                                icon="sap-icon://it-system"
                                state="None"
                                class="mwFacetaValor"/>
                        </VBox>
                        <VBox
                            width="12rem"
                            visible="{= !!${casoSap>/caso/reporter} }"
                            class="sapUiTinyMarginBottom">
                            <Label
                                text="{i18n>detalheSapRequisitante}"
                                class="mwFacetaRotulo sapUiTinyMarginBottom"/>
                            <ObjectStatus
                                text="{casoSap>/caso/reporter}"
                                icon="sap-icon://employee"
                                state="None"
                                class="mwFacetaValor"/>
                        </VBox>
                    </HBox>
                </f:expandedContent>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader pinnable="false">
                <MessageStrip
                    visible="{casoSap>/falha}"
                    type="Error"
                    showIcon="true"
                    text="{i18n>detalheSapErroCarregar}"
                    class="sapUiSmallMarginBottom"/>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <layout:Grid
                containerQuery="true"
                hSpacing="1"
                vSpacing="1"
                class="sapUiSmallMarginTop">
                <VBox width="100%">
                    <layoutData>
                        <layout:GridData span="XL3 L3 M12 S12"/>
                    </layoutData>
                    <f:Card width="100%" class="sapUiSmallMarginBottom">
                        <f:content>
                            <VBox width="100%">
                                <HBox
                                    width="100%"
                                    alignItems="Center"
                                    class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiTinyMarginTop sapUiTinyMarginBottom">
                                    <core:Icon
                                        src="sap-icon://document-text"
                                        size="1.5rem"
                                        class="sapUiSmallMarginEnd"/>
                                    <Title
                                        text="{i18n>detalheSapDescricao}"
                                        titleStyle="H5"/>
                                </HBox>
                                <!-- SEM width="100%": com as margens de 1rem a caixa estouraria o
                                     .sapFCardContent (overflow hidden), como nos cartoes do detalhe C4C. -->
                                <VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiTinyMarginTop sapUiSmallMarginBottom">
                                    <!-- FormattedText porque o payload traz <br/> e <p>; Text mostraria as tags. -->
                                    <FormattedText
                                        width="100%"
                                        visible="{= !!${casoSap>/caso/description} }"
                                        htmlText="{casoSap>/caso/description}"
                                        class="mwTextoCorrido"/>
                                    <!-- So com caso lido: carregando/falha nao tem descricao vazia. -->
                                    <Text
                                        visible="{= !!${casoSap>/caso} &amp;&amp; !${casoSap>/caso/description} }"
                                        text="{i18n>detalheSapDescricaoVazia}"
                                        class="mwTextoCorrido"/>
                                </VBox>
                            </VBox>
                        </f:content>
                    </f:Card>
                    <!-- Cartao inteiro escondido sem impacto informado: so o titulo nao diz nada. -->
                    <f:Card
                        width="100%"
                        visible="{= !!${casoSap>/caso/businessImpact} }"
                        class="sapUiSmallMarginBottom">
                        <f:content>
                            <VBox width="100%">
                                <HBox
                                    width="100%"
                                    alignItems="Center"
                                    class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiTinyMarginTop sapUiTinyMarginBottom">
                                    <core:Icon
                                        src="sap-icon://business-objects-experience"
                                        size="1.5rem"
                                        class="sapUiSmallMarginEnd"/>
                                    <Title
                                        text="{i18n>detalheSapImpacto}"
                                        titleStyle="H5"/>
                                </HBox>
                                <VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiTinyMarginTop sapUiSmallMarginBottom">
                                    <FormattedText
                                        width="100%"
                                        htmlText="{casoSap>/caso/businessImpact}"
                                        class="mwTextoCorrido"/>
                                </VBox>
                            </VBox>
                        </f:content>
                    </f:Card>
                    <!-- Ultimo cartao da coluna esquerda, embaixo de Descricao (o de Impacto
                         fica escondido quando o caso nao tem businessImpact, entao no caso comum
                         Anexos encosta direto na Descricao). Sem layoutData proprio: GridData em
                         cartao dentro de VBox e ignorado e ainda confunde o proximo leitor. -->
                    <f:Card width="100%" class="sapUiSmallMarginBottom">
                        <f:content>
                            <VBox width="100%">
                                <!-- SEM width="100%" neste HBox: com ele o "+" do uploader e
                                     cortado pelo overflow hidden do .sapFCardContent. -->
                                <HBox
                                    justifyContent="SpaceBetween"
                                    alignItems="Center"
                                    class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiTinyMarginTop sapUiTinyMarginBottom">
                                    <HBox alignItems="Center">
                                        <core:Icon
                                            src="sap-icon://attachment"
                                            size="1.5rem"
                                            class="sapUiSmallMarginEnd"/>
                                        <Title
                                            text="{i18n>detalheCasoSapAnexos}"
                                            titleStyle="H5"/>
                                    </HBox>
                                    <!-- multiple + sameFilenameAllowed: sem o segundo, o
                                         FileUploader ignora a reselecao do mesmo arquivo depois
                                         de um setValue(""). Extensao e tamanho ficam fora do
                                         controle (sem fileType/maximumFileSize) e vao no
                                         controller, arquivo por arquivo: o controle reprova a
                                         selecao inteira no primeiro ofensor e engole o change. -->
                                    <u:FileUploader
                                        id="fileUploaderAnexoCasoSap"
                                        name="anexoCasoSap"
                                        class="mwUploaderBotao"
                                        buttonOnly="true"
                                        icon="sap-icon://add"
                                        iconOnly="true"
                                        tooltip="{i18n>detalheCasoSapAnexoAdicionar}"
                                        multiple="true"
                                        sameFilenameAllowed="true"
                                        enabled="{= ${casoSap>/anexosEnviando} !== true &amp;&amp; !!${casoSap>/correlationId} }"
                                        change=".onDetalheCasoSapAnexoAdicionar">
                                        <u:layoutData>
                                            <FlexItemData shrinkFactor="0"/>
                                        </u:layoutData>
                                    </u:FileUploader>
                                </HBox>
                                <!-- SEM width="100%": mesmo estouro do cartao de Descricao. -->
                                <VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiTinyMarginTop sapUiSmallMarginBottom">
                                    <!-- Erro no cartao e nao por toast: a leitura do caso costuma
                                         falhar junto e dois avisos iguais se empilhariam. -->
                                    <MessageStrip
                                        visible="{casoSap>/anexosFalha}"
                                        type="Error"
                                        showIcon="true"
                                        text="{i18n>detalheCasoSapAnexosErroCarregar}"
                                        class="sapUiTinyMarginBottom"/>
                                    <List
                                        items="{casoSap>/anexos}"
                                        busy="{= ${casoSap>/anexosCarregando} === true }"
                                        busyIndicatorDelay="0"
                                        showSeparators="Inner">
                                        <noData>
                                            <IllustratedMessage
                                                illustrationType="sapIllus-NoData"
                                                illustrationSize="ExtraSmall"
                                                enableDefaultTitleAndDescription="false"
                                                title="{i18n>detalheCasoSapAnexosVazio}"/>
                                        </noData>
                                        <CustomListItem
                                            type="Active"
                                            press=".onDetalheCasoSapAnexoPress"
                                            busy="{= ${casoSap>baixando} === true || ${casoSap>enviando} === true }"
                                            busyIndicatorDelay="0">
                                            <HBox
                                                width="100%"
                                                alignItems="Center"
                                                justifyContent="SpaceBetween"
                                                class="sapUiSmallMargin">
                                                <HBox alignItems="Center">
                                                    <Avatar
                                                        displayShape="Square"
                                                        displaySize="S"
                                                        src="{path: 'casoSap>nome', formatter: 'formatter.anexoIcone'}"/>
                                                    <VBox class="sapUiSmallMarginBegin">
                                                        <Title titleStyle="H6" text="{casoSap>nome}"/>
                                                        <Text
                                                            text="{
                                                                parts: [
                                                                    {path: 'casoSap>tamanho'},
                                                                    {path: 'casoSap>quando'},
                                                                    {path: 'casoSap>autor'}
                                                                ],
                                                                formatter: 'formatter.anexoLegenda'
                                                            }"
                                                            class="mwLegenda"/>
                                                    </VBox>
                                                </HBox>
                                                <core:Icon
                                                    src="sap-icon://download"
                                                    decorative="false"
                                                    tooltip="{casoSap>nome}"/>
                                            </HBox>
                                        </CustomListItem>
                                    </List>
                                </VBox>
                            </VBox>
                        </f:content>
                    </f:Card>
                </VBox>
                <!-- Cartao central e nao mais um item da coluna: mesma grade do detalhe C4C,
                     onde o chat e a metade do meio ladeada por duas colunas estreitas. -->
                <f:Card width="100%" class="sapUiSmallMarginBottom">
                    <!-- f:layoutData: sem o namespace do pai o parser le a tag como filho direto. -->
                    <f:layoutData>
                        <layout:GridData span="XL6 L6 M12 S12"/>
                    </f:layoutData>
                    <f:content>
                        <VBox width="100%">
                            <HBox
                                width="100%"
                                alignItems="Center"
                                class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiTinyMarginTop sapUiTinyMarginBottom">
                                <core:Icon
                                    src="sap-icon://discussion"
                                    size="1.5rem"
                                    class="sapUiSmallMarginEnd"/>
                                <Title
                                    text="{i18n>detalheSapChat}"
                                    titleStyle="H5"/>
                            </HBox>
                            <!-- SEM width="100%": mesmo estouro do cartao de Descricao. -->
                            <VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiTinyMarginTop sapUiSmallMarginBottom">
                                <!-- Erro no cartao, nao por toast: falha junto com a
                                     dos campos empilharia dois avisos iguais. -->
                                <MessageStrip
                                    visible="{casoSap>/chatFalha}"
                                    type="Error"
                                    showIcon="true"
                                    text="{i18n>chatsSapErroCarregarComentarios}"
                                    class="sapUiTinyMarginBottom"/>
                                <!-- 20rem fixos: solta, a List cresceria com a conversa
                                     e empurraria o campo de escrita para fora da dobra. -->
                                <!-- Id com sufixo Sap (namespace unico da Main.view):
                                     o controller rola ate a ultima bolha. -->
                                <ScrollContainer
                                    id="detalheChatScrollSap"
                                    width="100%"
                                    height="20rem"
                                    vertical="true"
                                    horizontal="false"
                                    focusable="false">
                                    <List
                                        items="{casoSap>/chat}"
                                        busy="{= ${casoSap>/chatCarregando} === true }"
                                        busyIndicatorDelay="0"
                                        showSeparators="None">
                                        <noData>
                                            <!-- Some na falha: "Nenhum comentario" por cima
                                                 do erro afirmaria o que ninguem leu. -->
                                            <IllustratedMessage
                                                visible="{= ${casoSap>/chatFalha} !== true }"
                                                illustrationType="sapIllus-NoMail"
                                                illustrationSize="Small"
                                                title="{i18n>chatsSapSemMensagens}"
                                                description="{i18n>chatsSapSemMensagensDesc}"/>
                                        </noData>
                                        <CustomListItem>
                                            <!-- Dois HBox exclusivos por ${casoSap>eu}: a ordem
                                                 dos filhos muda, nao so o alinhamento. -->
                                            <VBox width="100%">
                                                <HBox
                                                    visible="{= ${casoSap>eu} !== true }"
                                                    width="100%"
                                                    alignItems="Start"
                                                    justifyContent="Start"
                                                    wrap="NoWrap"
                                                    class="mwChatLinha sapUiTinyMarginTopBottom">
                                                    <!-- Espacador em VBox, nao classe de margem:
                                                         so shrinkFactor 0 sobrevive ao aperto. -->
                                                    <VBox width="1rem">
                                                        <layoutData>
                                                            <FlexItemData
                                                                growFactor="0"
                                                                shrinkFactor="0"/>
                                                        </layoutData>
                                                    </VBox>
                                                    <!-- Fixo: a bolha do caso SAP nao tem o
                                                         flag "sistema" do chat do C4C. -->
                                                    <Avatar
                                                        displaySize="S"
                                                        src="sap-icon://customer">
                                                        <layoutData>
                                                            <FlexItemData
                                                                growFactor="0"
                                                                shrinkFactor="0"/>
                                                        </layoutData>
                                                    </Avatar>
                                                    <VBox width="1rem">
                                                        <layoutData>
                                                            <FlexItemData
                                                                growFactor="0"
                                                                shrinkFactor="0"/>
                                                        </layoutData>
                                                    </VBox>
                                                    <!-- minWidth 0: sem ele uma palavra longa trava
                                                         a bolha e o cartao corta a linha. -->
                                                    <VBox class="mwChatBolhaEntrada">
                                                        <layoutData>
                                                            <FlexItemData
                                                                growFactor="0"
                                                                shrinkFactor="1"
                                                                minWidth="0"/>
                                                        </layoutData>
                                                        <Title
                                                            titleStyle="H6"
                                                            text="{casoSap>autor}"
                                                            wrapping="true"/>
                                                        <Text
                                                            text="{casoSap>texto}"
                                                            wrapping="true"
                                                            renderWhitespace="true"
                                                            class="mwChatTextoQuebra"/>
                                                        <Text
                                                            width="100%"
                                                            text="{path: 'casoSap>quando', formatter: 'formatter.dataAbertura'}"
                                                            wrapping="false"
                                                            textAlign="Begin"
                                                            class="mwLegenda"/>
                                                    </VBox>
                                                </HBox>
                                                <HBox
                                                    visible="{= ${casoSap>eu} === true }"
                                                    width="100%"
                                                    alignItems="Start"
                                                    justifyContent="End"
                                                    wrap="NoWrap"
                                                    class="mwChatLinha sapUiTinyMarginTopBottom">
                                                    <VBox class="mwChatBolhaSaida">
                                                        <layoutData>
                                                            <FlexItemData
                                                                growFactor="0"
                                                                shrinkFactor="1"
                                                                minWidth="0"/>
                                                        </layoutData>
                                                        <HBox
                                                            width="100%"
                                                            justifyContent="End">
                                                            <Title
                                                                titleStyle="H6"
                                                                text="{casoSap>autor}"
                                                                wrapping="true"/>
                                                        </HBox>
                                                        <Text
                                                            text="{casoSap>texto}"
                                                            wrapping="true"
                                                            renderWhitespace="true"
                                                            class="mwChatTextoQuebra"/>
                                                        <Text
                                                            width="100%"
                                                            text="{path: 'casoSap>quando', formatter: 'formatter.dataAbertura'}"
                                                            wrapping="false"
                                                            textAlign="End"
                                                            class="mwLegenda"/>
                                                    </VBox>
                                                    <VBox width="1rem">
                                                        <layoutData>
                                                            <FlexItemData
                                                                growFactor="0"
                                                                shrinkFactor="0"/>
                                                        </layoutData>
                                                    </VBox>
                                                    <Avatar
                                                        displaySize="S"
                                                        src="sap-icon://employee">
                                                        <layoutData>
                                                            <FlexItemData
                                                                growFactor="0"
                                                                shrinkFactor="0"/>
                                                        </layoutData>
                                                    </Avatar>
                                                    <!-- 3rem deste lado, contra 1rem da entrada: e
                                                         aqui que cai a barra de rolagem. -->
                                                    <VBox width="3rem">
                                                        <layoutData>
                                                            <FlexItemData
                                                                growFactor="0"
                                                                shrinkFactor="0"/>
                                                        </layoutData>
                                                    </VBox>
                                                </HBox>
                                            </VBox>
                                        </CustomListItem>
                                    </List>
                                </ScrollContainer>
                                <!-- enabled cai no envio (POST da ALM sem deduplicacao) e na leitura
                                     (releitura em voo apagaria a bolha ja confirmada). -->
                                <!-- O id existe para o controller repor o texto quando o POST falha;
                                     maxLength espelha o teto do backend, senao so a recusa o revela. -->
                                <FeedInput
                                    id="detalheChatFeedInputSap"
                                    placeholder="{i18n>detalheSapChatPlaceholder}"
                                    buttonTooltip="{i18n>detalheSapChatEnviar}"
                                    icon="sap-icon://employee"
                                    maxLength="5000"
                                    post=".onDetalheSapEnviarMensagem"
                                    enabled="{= ${casoSap>/chatEnviando} !== true &amp;&amp; ${casoSap>/chatCarregando} !== true &amp;&amp; !!${casoSap>/correlationId} }"
                                    class="sapUiSmallMarginTop"/>
                            </VBox>
                        </VBox>
                    </f:content>
                </f:Card>
                <VBox width="100%">
                    <layoutData>
                        <layout:GridData span="XL3 L3 M12 S12"/>
                    </layoutData>
                    <f:Card width="100%" class="sapUiSmallMarginBottom">
                        <f:content>
                            <VBox width="100%">
                                <HBox
                                    width="100%"
                                    alignItems="Center"
                                    class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiTinyMarginTop sapUiTinyMarginBottom">
                                    <core:Icon
                                        src="sap-icon://technical-object"
                                        size="1.5rem"
                                        class="sapUiSmallMarginEnd"/>
                                    <Title
                                        text="{i18n>detalheSapDadosTecnicos}"
                                        titleStyle="H5"/>
                                </HBox>
                                <VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiTinyMarginTop sapUiSmallMarginBottom">
                                    <VBox
                                        visible="{= !!${casoSap>/caso/product} }"
                                        class="sapUiTinyMarginBottom">
                                        <Label
                                            text="{i18n>detalheSapProduto}"
                                            class="mwFacetaRotulo"/>
                                        <Text
                                            text="{casoSap>/caso/product}"
                                            class="mwFacetaValor"/>
                                    </VBox>
                                    <VBox
                                        visible="{= !!${casoSap>/caso/productFunction} }"
                                        class="sapUiTinyMarginBottom">
                                        <Label
                                            text="{i18n>detalheSapFuncaoProduto}"
                                            class="mwFacetaRotulo"/>
                                        <Text
                                            text="{casoSap>/caso/productFunction}"
                                            class="mwFacetaValor"/>
                                    </VBox>
                                    <VBox

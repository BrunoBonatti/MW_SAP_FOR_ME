{
  "name": "mw-monitor-chamados",
  "version": "1.0.11",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "//deploy-db": "Cria as tabelas de db/schema.cds (ChatVisualizacoes) no sqlite de db/. OBRIGATORIO uma vez depois de clonar/pull que traga db/schema.cds: como o [development] abaixo aponta para um ARQUIVO (nao :memory:), o cds watch NAO deploya sozinho - sem isto, ChamadosComMensagemNova e MarcarChatVisualizado respondem 500 'no such table' e o chat perde notificacao/visualizado. NAO encadear no watch: cds deploy recria a tabela, apagando o historico de visualizacao a cada restart.",
    "deploy-db": "cds deploy",
    "watch-mw_monitor_chamados": "cds watch --open megawork.mwmonitorchamados/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa"
      },
      "db": {
        "//": "Sem isto o @cap-js/sqlite usa ':memory:' em dev: cada restart do cds watch recria o banco do zero e apaga ChatVisualizacoes, fazendo toda notificacao de chat voltar a 'nao visualizada'. Arquivo em disco sobrevive ao restart; *.sqlite ja esta no .gitignore. So [development] - producao continua auto-detectando HANA (HDI container do mta.yaml) sem isto interferir.",
        "[development]": {
          "kind": "sqlite",
          "credentials": { "url": "db/mw-monitor-chamados.sqlite" }
        }
      },
      "kinds": {
        "c4c": {
          "kind": "odata-v2",
          "[production]": {
            "credentials": {
              "destination": "C4C",
              "path": "/sap/c4c/odata/v1/c4codataapi"
            }
          }
        }
      },
      "c4c": {
        "kind": "c4c"
      },
      "employeeanduser": {
        "kind": "c4c",
        "model": "srv/external/employeeanduser",
        "csrf": {
          "method": "get"
        },
        "csrfInBatch": true
      },
      "contact": {
        "kind": "c4c",
        "model": "srv/external/contact",
        "csrf": {
          "method": "get"
        },
        "csrfInBatch": true
      },
      "ticket": {
        "kind": "c4c",
        "model": "srv/external/ticket",
        "csrf": {
          "method": "get"
        },
        "csrfInBatch": true
      },
      "account": {
        "kind": "c4c",
        "[development]": {
          "credentials": {
            "url": "https://my369126.crm.ondemand.com/sap/c4c/odata/v1/c4codata"
          }
        },
        "[production]": {
          "credentials": {
            "destination": "C4C",
            "path": "/sap/c4c/odata/v1/c4codata"
          }
        },
        "csrf": {
          "method": "get"
        },
        "csrfInBatch": true
      },
      "changedoclist": {
        "kind": "c4c",
        "model": "srv/external/changedoclist",
        "[development]": {
          "credentials": {
            "url": "https://my369126.crm.ondemand.com/sap/c4c/odata/v1/changedoclist"
          }
        },
        "[production]": {
          "credentials": {
            "destination": "C4C",
            "path": "/sap/c4c/odata/v1/changedoclist"
          }
        },
        "csrf": {
          "method": "get"
        },
        "csrfInBatch": true
      },
      "destinations": true,
      "html5-repo": true,
      "workzone": true,
      "servicerequestinteraction": {
        "kind": "c4c",
        "model": "srv/external/servicerequestinteraction",
        "[development]": {
          "credentials": {
            "url": "https://my369126.crm.ondemand.com/sap/c4c/odata/v1/servicerequestinteraction"
          }
        },
        "[production]": {
          "credentials": {
            "destination": "C4C",
            "path": "/sap/c4c/odata/v1/servicerequestinteraction"
          }
        },
        "csrf": {
          "method": "get"
        },
        "csrfInBatch": true
      },
      "SAP.Cloud.ALM.ITSM": {
        "kind": "rest",
        "model": "srv/external/CALM_ITSM",
        "[production]": {
          "credentials": {
            "destination": "CALM_ITSM",
            "path": "/api/calm-itsmapi/v1"
          }
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ]
}